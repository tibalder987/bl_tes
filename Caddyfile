{
	frankenphp
	auto_https off
}

:80 {
	root * /app/public
	encode zstd gzip

	# Long-lived cache for content-hashed Webpack assets
	@hashedAssets {
		path /build/*
		path_regexp \.[0-9a-f]{8,}\.(js|css|woff2|woff|otf|png|jpg|webp|svg)$
	}
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	# Static public assets — 1 week cache (no hash in filename)
	@staticAssets {
		path /images/* /fonts/* /shapes/*
		not path_regexp \.[0-9a-f]{8,}\.(js|css|woff2|woff|otf|png|jpg|webp|svg)$
	}
	header @staticAssets Cache-Control "public, max-age=604800"

	php_server
}

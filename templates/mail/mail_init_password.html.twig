{% extends 'mail/base.html.twig' %}

{% block title %}Initialisation de votre mot de passe{% endblock %}

{% block content %}
    <div style="background-color: #FCFCFC; padding: 40px 15px 20px 15px">
        <b class="fw-bold text-center">
            Félicitations !<br/>Un accès administrateur à l'application suivante vient de vous être attribué !

            <br>
            <br>
            <b>Votre identifiant : </b>{{ user.email }}
            <br>
            <br>Merci de cliquer sur ce lien afin d'initialiser votre mot de passe.
        </b>
        <br>
        <br>
        <table bgcolor="#213ea6" role="presentation" align="center" width="280" style="max-width:280px;" cellspacing="0" cellpadding="0" border="0">
            <tbody>
            <tr>
                <td align="center" style="font-size: 20px; line-height: 20px;" height="50">
                    <a style="text-decoration:none;font-weight:bold;color:#fff;width:100%;height:50px;font-size:20px;" href="{{ absolute_url }}{{ path('app_password_init', {'token': user.tokenInitPassword })}}">Créer votre mot de passe</a>
                </td>
            </tr>
            </tbody>
        </table>
        <br><br>
    </div>
{% endblock %}


{% extends 'base.html.twig' %}

{% block title %}
	{{ 'page_title'|trans({}, 'dine') }}
{% endblock %}

{% block meta %}
	<meta name="description" content="{{ 'meta_description'|trans({}, 'dine')|e('html_attr') }}"/>
	<meta name="keywords" content="{{ 'meta_keywords'|trans({}, 'dine')|e('html_attr') }}"/>
	<meta property="og:title" content="{{ 'og_title'|trans({}, 'dine')|e('html_attr') }}"/>
	<meta property="og:description" content="{{ 'og_description'|trans({}, 'dine')|e('html_attr') }}"/>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
{% endblock %}

{% set bodyClass = 'dinepage' %}

{% block body %}
	<main id="main-content" class="dine-page">
		{% include 'components/dine/_hero.html.twig' %}
		{% include 'components/dine/_section-intro.html.twig' %}
		{% include 'components/dine/_section-restaurant.html.twig' %}
		{% include 'components/dine/_section-bar.html.twig' %}
		{% include 'components/dine/_section-cuisine.html.twig' %}
		{% include 'components/dine/_section-cocktails.html.twig' %}
	</main>
{% endblock %}

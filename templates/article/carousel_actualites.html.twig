<div class="slider_articles_builder">
    {% for article in articles %}
        <div class="px-3">
            {% set imageActu = asset('img/shop/ico-visuel-produit.jpeg') %}
            {% if article.imageName is not null %}
                {% set imageActu = vich_uploader_asset(article,"image") %}
            {% endif %}
            <div class="article_item article_item3 rounded-3 overflow-hidden">
                <div class="actu_image overflow-hidden">
                    <img class="scale_hover" src="{{ imageActu | imagine_filter('list_news3') }}" alt="{{ article.title }}" />
                </div>
                <div class="actu_info2 px-4 pt-4">
                    <div class="p-0 p-md-2 px-md-2">
                        <span class="pt-3 d-block h-auto mb-3 builder_color1 fw-semibold letter-spacing1 builder_title_font2 actu_title line-height1">
                            {% set actu_title = article.title %}
                            {% if article.title|length > 45 %}
                                {% set actu_title = article.title|slice(0, 45) ~ '...' %}
                            {% endif %}
                            {{ actu_title | raw }}
                        </span>
                    </div>
                </div>
                <a class="full_hover" href="{{ path('app_article_actualite_detail', {'slug' : article.path}) }}"></a>
                <div class="actu_btn px-4 pb-4">
                    <div class="p-0 p-md-2">
                        <a href="{{ path('app_article_actualite_detail', {'slug' : article.path}) }}" class="border-bottom border-2 px-0 py-1 text-decoration-none fw-bold d-inline-flex align-items-center">
                            <span class="d-inline-block">Voir plus</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
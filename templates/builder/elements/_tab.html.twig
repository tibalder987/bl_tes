
<div class="container py-3">
    <div class="row">
        <div class="col-lg-12">
            <div class="tabs">
                <ul class="nav nav-tabs nav-justified flex-column flex-md-row">
                    {% for tab in element %}
                    <li class="nav-item {{ tab.active ? 'active' }}">
                        <a class="nav-link" href="#{{ tab.id }}" data-toggle="tab" class="text-center">{{ tab.title }}</a>
                    </li>
                    {% endfor %}
                </ul>
                <div class="tab-content">
                    {% for tab in element %}
                    <div id="{{ tab.id }}" class="tab-pane {{ tab.active ? 'active' }}">
                        {% import 'frontend/builder_page/_builder.html.twig' as builder %}
                        {{ builder.buildElements(tab.contentElements) }}
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

    </div>

</div>

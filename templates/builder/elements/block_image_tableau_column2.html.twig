{% set nbRows = 0 %}
{% set nbCols = {} %}
{% set breakLoop = false %}
{% set nbheader = 0 %}

{% for i in 0..7 %}
    {% if not breakLoop %}
        {% set allEmpty = true %}
        {% for j in 0..4 %}
            {% if element['table_cell_'~ i ~ '_' ~ j] is not empty %}
                {% set allEmpty = false %}
                {% set nbCols = nbCols|merge({('t'~j):true}) %}
            {% endif %}
        {% endfor %}

        {% if allEmpty == true %}
            {% set nbRows = i %}
            {% set breakLoop = true %}
        {% endif %}
    {% endif %}
{% endfor %}

{% if not breakLoop %}
    {% set nbRows = 7 %}
{% endif %}

{% if element.headers != "first_line" %}
    {% set nbheader = 1 %}
{% endif %}
{% set nbRows = nbRows - 1 %}


{% if element.colType == "12" %}
    {% set col1 = "col-xl-6" %}
    {% set col2 = "col-xl-6" %}
{% endif %}
{% if element.colType == "13" %}
    {% set col1 = "col-xl-4" %}
    {% set col2 = "col-xl-8" %}
{% endif %}
{% if element.colType == "23" %}
    {% set col1 = "col-xl-8" %}
    {% set col2 = "col-xl-4" %}
{% endif %}

{% if element.position == "tableau_image" %}
    {% set first_element = 'order-0 order-xl-1' %}
    {% set second_element = 'order-1 order-xl-0' %}
{% endif %}
{% if element.fullwidth == 'false' %}<div class="container-xl position-relative">{% endif %}
    <div class="px-3 px-xl-0">
        <div class="builder_block_image_tableau_column2 position-relative pt-3 pb-5 px-xl-5">
            <div class="wysiwyg_content">
                <div class="row">
                    <div class="{{ col1 }} d-flex align-items-start justify-content-center pt-4 {% if first_element is defined %}{{ first_element }}{% endif %}">
                        {% if element.imagePath_url %}
                            <img src="{{ absolute_url(element.imagePath_url) }}" alt="{{ element.titleImg }}" />
                        {% endif %}
                    </div>
                    <div class="{{ col2 }} d-flex align-items-start pt-4 {% if second_element is defined %}{{ second_element }}{% endif %}">
                        <div class="ps-xl-5 w-100 text-center">
                            <div class="pt-3 pt-xl-0 pb-4">
                                <div class="table-responsive">
                                    <table class="table table-bordered">
                                        <thead>
                                        {% for i in 0..nbheader %}
                                            <tr>
                                                {% for j in 0..(nbCols|length -1) %}
                                                    <th class="builder_small_text_size text-primary px-2 py-3 px-lg-3 py-lg-4">{{ element['table_cell_'~ i ~ '_' ~ j] }}</th>
                                                {% endfor %}
                                            </tr>
                                        {% endfor %}
                                        </thead>
                                        <tbody>
                                        {% for i in (nbheader+1)..nbRows %}
                                            <tr>
                                                {% for j in 0..(nbCols|length -1) %}
                                                    {% if loop.index0 == 0 and element.type != "regular" %}
                                                        <th class="builder_small_text_size text-primary p-2 p-lg-3">
                                                            {{ element['table_cell_'~ i ~ '_' ~ j] }}
                                                        </th>
                                                    {% else %}
                                                        <td class="builder_small_text_size p-2 p-lg-3">{{ element['table_cell_'~ i ~ '_' ~ j] }}</td>
                                                    {% endif %}
                                                {% endfor %}
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% if element.fullwidth == 'false' %}</div>{% endif %}

{% if element.fullwidth == 'false' %}<div class="container-xl">{% endif %}
    <div class="px-3 px-xl-0">
        <div class="builder_button pt-3 pb-4 px-xl-5">
            <div class="text-center text-lg-{{ element.alignment }}">
                {% if element.title and element.url %}
                    <a href="{{ element.url }}" target="{{ element.target }}" class="btn btn-dark btn-lg rounded-5 fw-normal fs-6 text-uppercase">
                        {{ element.title }}
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
{% if element.fullwidth == 'false' %}</div>{% endif %}



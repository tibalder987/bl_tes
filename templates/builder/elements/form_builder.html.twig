<div class="container py-5">
    {% if title is defined and title is not empty %}
        <div class="row mb-4">
            <div class="col-12 text-center">
                <h2 class="h3">{{ title }}</h2>
                {% if description is defined and description is not empty %}
                    <div class="lead text-muted">{{ description|raw }}</div>
                {% endif %}
            </div>
        </div>
    {% endif %}

    <div class="row justify-content-center">
        <div class="col-12 {% if fullwidth is not defined or not fullwidth %}col-lg-8{% endif %}">
            <div class="form-builder-container p-4 bg-white rounded shadow-sm">
                
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'error' ? 'danger' : label }} mb-4">
                            {{ message|raw }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {% if formId is defined and formId %}
                    {{ render(controller('App\\Controller\\FormController::renderForm', { 'formId': formId })) }}
                {% else %}
                    <div class="alert alert-warning text-center">
                        Aucun formulaire sélectionné.
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="container-xl position-relative">
    <div class="px-3 px-xl-0">
        <div class="builder_last_news pt-5 pb-0 px-xl-5" data-aos="fade-up">
            <div class="row">
                <div class="order-1 order-xl-0 col-xl-8">
                    {% set path = path('app_news_last', {'nbResults': element.limit}) %}
                    {% if element.categoryID is not empty %}
                        {% set path = path('app_news_category_last', {'path': categoryID, 'nbResults': element.limit}) %}
                    {% endif %}
                    {{ render(path) }}
                </div>
                <div class="mb-5 order-0 order-xl-1 col-xl-4">
                    <div class="ps-xl-3">
                        {% if element.topTitle %}
                            <div class="prefix_line mb-3">{{ element.topTitle }}</div>
                        {% endif %}
                        <{{ element.typetitle }} class="builder_line_height1 {{ element.styletitle }} builder_color2">
                            {{ element.title | raw }}
                        </{{ element.typetitle }}>
                        <div class="wysiwyg_content">{{ element.description | raw }}</div>

                        {% set path = path('app_article_actualites') %}
                        {% if element.categoryID is not empty %}
                            {% set path = path('app_article_actualites_filter_category', {'path': element.categoryID}) %}
                        {% endif %}
                        {% if element.buttonTitle %}
                            <div class="text-end">
                                <a href="{{ path }}" class="mt-3 btn btn-dark btn-lg rounded-5 fw-normal fs-6 text-uppercase">{{ element.buttonTitle }}</a>
                            </div>

                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-xxl position-relative">
    <div class="px-3 px-xl-0">
        <div class="px-xl-5">
            <div class="row">
                {% if element.title %}
                <div class="col-md-6 col-lg-4 col-xl-3 d-flex pt-4">
                    <div class="card data_bg rounded-0 border-0" data-bg="{{ element["imagePath_url"] }}">
                        <div class="card-body px-xl-4 builder_minheightcard d-flex align-items-end">
                            <h4 class="pt-4 card-title fs-3 text-white fw-bold text-shadow text-end">{{ element.title }}</h4>
                        </div>
                    </div>
                </div>
                {% endif %}
                {% for item in element.steps|default([]) %}
                    {% set title = item.title|default(null) %}
                    {% set step = item.step|default(null) %}
                    {% set paragraph = item.paragraph|default(null) %}

                    {% if title %}
                        <div class="col-md-6 col-lg-4 col-xl-3 pt-4 d-flex">
                            <div class="card bg-primary border-0 rounded-0">
                                <div class="card-body px-xl-4 builder_minheightcard">
                                    <div class="fs-1 fw-bold pt-4 text-white">{{ step }}</div>
                                    <h5 class="card-title text-white">{{ title }}</h5>
                                    <div class="card-text text-white">{{ paragraph | raw }}</div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>
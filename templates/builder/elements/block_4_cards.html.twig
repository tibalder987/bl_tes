<div class="container-xl position-relative">
    <div class="px-4 px-xxl-5">
        <div class="builder_block_4_cards py-5" data-aos="fade-up">
            <div class="row">
                <div class="col-7">
                    {% if element.topTitle %}
                        <div class="prefix_line mb-3">{{ element.topTitle }}</div>
                    {% endif %}
                    <{{ element.typetitle }} class="builder_line_height1 {{ element.styletitle }} builder_color2">
                        {{ element.title | raw }}
                    </{{ element.typetitle }}>
                </div>
                <div class="col-5 d-flex justify-content-end align-items-center">
                    {% if element.buttonTitle %}
                        <a href="{{ element.buttonPath }}" class="btn btn-dark btn-lg rounded-5 fw-normal fs-6 text-uppercase">{{ element.buttonTitle }}</a>
                    {% endif %}
                </div>
            </div>

            <div class="row pt-4 justify-content-center">
                {% for item in element.cards|default([]) %}
                    {% set title = item.title|default(null) %}
                    {% if title %}
                        <div class="d-flex col-md-6 col-xl-3 text-{{ item.alignment|default('start') }} pt-3 pt-lg-4">
                            <div class="opacity_hover w-100 pt-5 pb-4 px-5 rounded-4 bg-primary">
                                {% if item.imageIco|default(null) %}
                                    <span class="{{ item.imageIco }} text-white size-icon"></span>
                                {% endif %}
                                <div class="pt-3 builder_size5 fw-semibold builder_title_font text-white line-height1">{{ title }}</div>
                                <div class="mt-2 text-white">
                                    <p>{{ item.description|default(null) }}</p>
                                </div>
                                {% if item.linkTitle|default(null) %}
                                    <a href="{{ item.linkPath|default(null) }}" class="small fw-bold text-decoration-none builder_color1">{{ item.linkTitle }}</a>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>

</div>
{% set nbRows = 0 %}
{% set nbCols = {} %}
{% set breakLoop = false %}
{% set nbheader = 0 %}

{% for i in 0..19 %}
    {% if not breakLoop %}
        {% set allEmpty = true %}
        {% for j in 0..4 %}
            {% if element['table_cell_'~ i ~ '_' ~ j] is not empty %}
                {% set allEmpty = false %}
                {% set nbCols = nbCols|merge({('t'~j):true}) %}
            {% endif %}
        {% endfor %}

        {% if allEmpty == true %}
            {% set nbRows = i %}
            {% set breakLoop = true %}
        {% endif %}
    {% endif %}
{% endfor %}

{% if not breakLoop %}
    {% set nbRows = 19 %}
{% endif %}

{% if element.headers != "first_line" %}
    {% set nbheader = 1 %}
{% endif %}
{% set nbRows = nbRows - 1 %}

<div class="container-xl position-relative">
    <div class="px-3 px-xl-0">
        <div class="builder_table pt-3 pb-4 px-xl-5">
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                    {% for i in 0..nbheader %}
                        <tr>
                            {% for j in 0..(nbCols|length -1) %}
                                <th class="builder_small_text_size text-primary px-2 py-3 px-lg-3 py-lg-4">{{ element['table_cell_'~ i ~ '_' ~ j] }}</th>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </thead>
                    <tbody>
                    {% for i in (nbheader+1)..nbRows %}
                        <tr>
                            {% for j in 0..(nbCols|length -1) %}
                                {% if loop.index0 == 0 and element.type != "regular" %}
                                    <th class="builder_small_text_size text-primary p-2 p-lg-3">
                                        {{ element['table_cell_'~ i ~ '_' ~ j] }}
                                    </th>
                                {% else %}
                                    <td class="builder_small_text_size p-2 p-lg-3">{{ element['table_cell_'~ i ~ '_' ~ j] | nl2br }}</td>
                                {% endif %}
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
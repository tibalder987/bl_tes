{% extends 'base.html.twig' %}

{% block title %}Page introuvable
{% endblock %}

{% block body %}
	<main class="page-error-404" role="main">
		<div class="page-error-404__inner">
			<p class="page-error-404__code" aria-hidden="true">404</p>
			<h1 class="page-error-404__title">Page introuvable</h1>
			<p class="page-error-404__lead">
				La page demandée n’existe pas ou a été déplacée.
			</p>
			<div class="page-error-404__actions">
				<a href="{{ path('app_home_page') }}" class="btn btn-lg-custom rounded-5 btn-outline-primary">
					Retour à l’accueil
				</a>
			</div>
		</div>
	</main>
{% endblock %}

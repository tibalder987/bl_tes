{# templates/admin/fields/submission_data.html.twig #}
{% set submission = entity.instance %}
{% set formEntity = submission.form %}
{% set schema = formEntity.schemaData %}
{% set data = field.value %}

{% if schema and schema.steps is defined %}
<div class="mt-2">
    <table class="table table-bordered table-striped" style="max-width: 800px;">
        <tbody>
            {% for step in schema.steps %}
                <tr><th colspan="2" class="bg-light text-primary"><i class="fa fa-folder-open me-2"></i> {{ step.title }}</th></tr>
                {% for fieldDef in step.fields %}
                    {% if fieldDef.type != 'paragraph' %}
                        <tr>
                            <td style="width: 40%"><strong>{{ fieldDef.label }}</strong></td>
                            <td>
                                {% set val = data[fieldDef.id] ?? '' %}
                                {% if val is iterable %}
                                    {{ val|join(', ') }}
                                {% else %}
                                    {{ val|nl2br }}
                                {% endif %}
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
    <pre>{{ data|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
{% endif %}

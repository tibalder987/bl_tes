<section class="hero-section" aria-label="{{ 'hero.title'|trans({}, 'dine')|e('html_attr') }}">
	<picture>
		<source media="(max-width: 768px)" type="image/webp" srcset="{{ asset('images/dine/section-hero/background-800.webp') }}">
		<source type="image/webp" srcset="{{ asset('images/dine/section-hero/background.webp') }}">
		<img
			src="{{ asset('images/dine/section-hero/background.jpg') }}"
			class="hero-section__background"
			alt="{{ 'hero.background_alt'|trans({}, 'dine')|e('html_attr') }}"
			loading="eager"
			fetchpriority="high"
			width="1536"
			height="1024"
			sizes="100vw">
	</picture>
	<div class="hero-section__content">
		<div class="hero-section__title">{{ 'hero.title'|trans({}, 'dine') }}</div>
		<div class="hero-section__subtitle">
			<span>{{ 'hero.flavors'|trans({}, 'dine') }}</span>
			{{ 'hero.to'|trans({}, 'dine') }}
			<span class="section__subtitle-2">{{ 'hero.share'|trans({}, 'dine') }}</span>
		</div>
	</div>
</section>

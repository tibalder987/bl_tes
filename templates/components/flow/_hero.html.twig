<section class="hero-section" aria-label="{{ 'hero.title'|trans({}, 'flow')|e('html_attr') }}">
	<picture>
		<source type="image/webp" srcset="{{ asset('images/flow/section-hero/background.webp') }}">
		<img
			src="{{ asset('images/flow/section-hero/background.jpg') }}"
			class="hero-section__background"
			alt="{{ 'hero.background'|trans({}, 'flow')|e('html_attr') }}"
			loading="eager"
			fetchpriority="high"
			width="1920"
			height="967"
			sizes="100vw">
	</picture>
	<div class="hero-section__content">
		<div class="hero-section__title">{{ 'hero.title'|trans({}, 'flow') }}</div>
		<div class="hero-section__subtitle">
			{{ 'hero.spaceto'|trans({}, 'flow')|raw }}
			<span class="section__subtitle-2">{{ 'hero.flow'|trans({}, 'flow') }}</span>
		</div>
	</div>
</section>

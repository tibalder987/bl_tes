<section class="section-3 have-animation" aria-labelledby="section-stay-heading">
	<div class="section-3__content">
		<picture>
			<source type="image/webp" srcset="{{ asset('images/home/section-3/sunset.webp') }}" sizes="(max-width: 768px) 100vw, 60vw">
			<img
				data-aos="fade-down" data-aos-delay="200"
				src="{{ asset('images/home/section-3/sunset.jpg') }}"
				class="section-3__sunset"
				alt="{{ 'img.sunset'|trans({}, 'home')|e('html_attr') }}"
				sizes="(max-width: 768px) 100vw, 60vw"
				loading="lazy" decoding="async" width="323" height="434">
		</picture>
		<div class="section-3__left">
			<div class="section-3__images">
				<picture>
					<source type="image/webp" srcset="{{ asset('images/home/section-3/stay.webp') }}" sizes="(max-width: 768px) 80vw, 30vw">
					<img
						data-aos="fade-up" data-aos-delay="200"
						src="{{ asset('images/home/section-3/stay.jpg') }}"
						class="section-3__fare-peaks"
						alt="{{ 'img.stay'|trans({}, 'home')|e('html_attr') }}"
						sizes="(max-width: 768px) 80vw, 30vw"
						loading="lazy" decoding="async" width="480" height="640">
				</picture>
			</div>
		</div>
		<div class="section-3__right">
			<h3 id="section-stay-heading" class="section-3__title icon-title">{{ 's3.title'|trans({}, 'home') }}</h3>
			<p>{{ 's3.p'|trans({}, 'home')|raw }}</p>
			<div>
				<a href="{{ path('app_stay') }}" class="btn-secondary">
					{{ 's3.btn'|trans({}, 'home') }}
					<i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
				</a>
			</div>
		</div>
	</div>
</section>

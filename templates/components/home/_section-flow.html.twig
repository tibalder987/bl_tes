<section class="section-5 have-animation" aria-labelledby="section-flow-heading">
	<picture>
		<source type="image/webp" srcset="{{ asset('images/home/section-5/water.webp') }}" sizes="(max-width: 768px) 100vw, 50vw">
		<img
			src="{{ asset('images/home/section-5/water.jpg') }}"
			data-aos="fade-down" data-aos-delay="200"
			class="section-5__eagle-rays"
			alt="{{ 'img.water'|trans({}, 'home')|e('html_attr') }}"
			sizes="(max-width: 768px) 100vw, 50vw"
			loading="lazy" decoding="async" width="514" height="692">
	</picture>
	<div class="section-5__content">
		<div class="section-5__left">
			<div class="section-5__images">
				<picture>
					<source type="image/webp" srcset="{{ asset('images/home/section-5/borabora_sunset.webp') }}" sizes="(max-width: 768px) 80vw, 30vw">
					<img
						src="{{ asset('images/home/section-5/borabora_sunset.jpg') }}"
						data-aos="fade-up" data-aos-delay="400"
						class="section-5__sunset-sailboat"
						alt="{{ 'img.flow'|trans({}, 'home')|e('html_attr') }}"
						sizes="(max-width: 768px) 80vw, 30vw"
						loading="lazy" decoding="async" width="480" height="640">
				</picture>
			</div>
		</div>
		<div class="section-5__right">
			<h3 id="section-flow-heading" class="section-5__title icon-title">{{ 's5.title'|trans({}, 'home') }}</h3>
			<p>{{ 's5.p'|trans({}, 'home')|raw }}</p>
			<div>
				<a href="{{ path('app_flow') }}" class="btn-secondary">
					{{ 's5.btn'|trans({}, 'home') }}
					<i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
				</a>
			</div>
		</div>
	</div>
</section>

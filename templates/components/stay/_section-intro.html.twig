<section class="section-1 have-animation" aria-labelledby="stay-intro-heading">
	<div class="section-1__content">
		<div class="section-1__left">
			<div class="section-1__images">
				<picture>
					<source type="image/webp" srcset="{{ asset('images/stay/section-1/meet.webp') }}" sizes="(max-width: 991px) 90vw, (max-width: 1430px) 35vw, 560px">
					<img
						data-aos="fade-up"
						src="{{ asset('images/stay/section-1/meet.jpg') }}"
						class="section-1__lagoon-deck"
						alt="{{ 'img.meet'|trans({}, 'stay')|e('html_attr') }}"
						width="2930" height="3906"
						loading="eager"
						decoding="async"
						sizes="(max-width: 991px) 90vw, (max-width: 1430px) 35vw, 560px">
				</picture>
			</div>
		</div>
		<div class="section-1__right">
			<h1 id="stay-intro-heading" class="section-1__title">{{ 's1.title'|trans({}, 'stay') }}<br><span class="shape">{{ 's1.title_shape'|trans({}, 'stay') }}</span>
			</h1>
			<div class="section-1__text">
				<p>{{ 's1.p1'|trans({}, 'stay') }}</p>
				<p>{{ 's1.p2'|trans({}, 'stay') }}</p>
			</div>
			<div class="section-1__subcontent-content">
				<p class="section-1__subcontent-text">
					{{ 's1.sub'|trans({}, 'stay') }}
					<span class="shape">{{ 's1.sub_shape'|trans({}, 'stay') }}</span>
				</p>
				<div>
					<a href="https://agilysis.com" class="btn-secondary">{{ 's1.btn'|trans({}, 'stay') }}
						<i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

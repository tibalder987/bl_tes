<section class="hero-section" aria-label="{{ 'hero.line1'|trans({}, 'stay')|e('html_attr') }}">
	<picture>
		<source media="(max-width: 768px)" type="image/webp" srcset="{{ asset('images/stay/section-hero/background-800.webp') }}">
		<source type="image/webp" srcset="{{ asset('images/stay/section-hero/background.webp') }}">
		<img
			src="{{ asset('images/stay/section-hero/background.jpg') }}"
			class="hero-section__background"
			alt="{{ 'hero.background'|trans({}, 'stay')|e('html_attr') }}"
			loading="eager"
			fetchpriority="high"
			width="1920"
			height="967"
			sizes="100vw">
	</picture>
	<div class="hero-section__content">
		<div class="hero-section__title">{{ 'hero.line1'|trans({}, 'stay') }}</div>
		<div class="hero-section__subtitle">
			{{ 'hero.sub_epilogue'|trans({}, 'stay')|raw }}
			<span class="section__subtitle-2">{{ 'hero.sub_balney'|trans({}, 'stay') }}</span>
		</div>
	</div>
</section>

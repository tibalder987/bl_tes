<section class="section-6 have-animation" aria-labelledby="story-values-heading">
	<div class="section-6__content">
		<div class="section-6__left">
			<h2 id="story-values-heading" class="section-6__title icon-title">
				<div>{{ 's6.title'|trans({}, 'our_story')|raw }}</div>
			</h2>
			<div class="section-6__left-content">
				<div class="section-6__left-content-text">
					<p>{{ 's6.p1'|trans({}, 'our_story')|raw }}</p>
					<p>{{ 's6.p2'|trans({}, 'our_story')|raw }}</p>
					<p>{{ 's6.p3'|trans({}, 'our_story')|raw }}</p>
					<p>{{ 's6.p4'|trans({}, 'our_story')|raw }}</p>

				<div class="section-6__right">
					<picture>
						<source type="image/webp" srcset="{{ asset('images/our-story/section-6/name-board.webp') }}" sizes="(max-width: 991px) 70vw, 35vw">
						<img
							data-aos="fade-up" data-aos-delay="400"
							src="{{ asset('images/our-story/section-6/name-board.png') }}"

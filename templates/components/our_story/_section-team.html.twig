			</div>
		</div>
		<div class="section-5__right">
			<h2 id="story-team-heading" class="section-5__title icon-title-red">{{ 's5.title'|trans({}, 'our_story')|raw }}</h2>
			<div class="section-5__text">
				<p>{{ 's5.p1'|trans({}, 'our_story')|raw }}</p>
				<p>{{ 's5.p2'|trans({}, 'our_story')|raw }}</p>
				<p>{{ 's5.p3'|trans({}, 'our_story')|raw }}</p>
				<p>{{ 's5.p4'|trans({}, 'our_story')|raw }}</p>
			</div>
		</div>

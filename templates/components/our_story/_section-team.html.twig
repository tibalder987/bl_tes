<section class="section-5" aria-labelledby="story-team-heading">
	<div class="section-5__content">
		<div class="section-5__left">
			<div class="section-5__images">
				<picture>
					<source type="image/webp" srcset="{{ asset('images/our-story/section-5/group_dexter.webp') }}" sizes="(max-width: 991px) 80vw, 40vw">
					<img
						data-aos="fade-up" data-aos-delay="200"
						src="{{ asset('images/our-story/section-5/group_dexter.jpg') }}"
						class="section-5__dexter-team-portrait"
						alt="{{ 'img.dexter_team'|trans({}, 'our_story')|e('html_attr') }}"
						width="800" height="500"
						loading="lazy" decoding="async"
						sizes="(max-width: 991px) 80vw, 40vw">

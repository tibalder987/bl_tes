	<div class="section-5__content reverse">
		<div class="section-5__right">
			<div class="section-5__text">
				<p>{{ 's5.rev.p1'|trans({}, 'our_story')|raw }}</p>
				<p>{{ 's5.rev.p2'|trans({}, 'our_story')|raw }}</p>
				<p>{{ 's5.rev.p3'|trans({}, 'our_story')|raw }}</p>
			</div>
		</div>
		<div class="section-5__left">
			<div class="section-5__images">

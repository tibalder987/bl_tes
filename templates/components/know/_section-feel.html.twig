{# ====================================================================
		Where it starts to feel real…
==================================================================== #}
<section class="know-page__section know-page__section--feel" aria-labelledby="know-feel-heading">
	<h2 id="know-feel-heading" class="know-page__section-title-red">
		{{ 'feel.title'|trans({}, 'know')|raw }}
	</h2>

	<div class="know-page__section-content know-page__section-content--stack">
		<div class="know-page__section-text">
			<p>{{ 'feel.p1'|trans({}, 'know')|raw }}</p>
			<p>{{ 'feel.p2'|trans({}, 'know')|raw }}</p>
			<p>{{ 'feel.p3'|trans({}, 'know')|raw }}</p>
			<p>{{ 'feel.p4'|trans({}, 'know')|raw }}</p>
			<p>{{ 'feel.p5'|trans({}, 'know')|raw }}</p>
			<p>{{ 'feel.p6_open'|trans({}, 'know')|raw }}</p>
			<div class="section-3__subcontent-content">
				<p class="section-3__subcontent-text">
					{{ 'feel.cta'|trans({}, 'know')|raw }}
				</p>
			</div>
		</div>
	</div>
</section>

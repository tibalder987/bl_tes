{% extends 'base.html.twig' %}

{% block title %}
	{{ 'page_title'|trans({}, 'our_story') }}
{% endblock %}

{% block meta %}
	<meta name="description" content="{{ 'meta_description'|trans({}, 'our_story')|e('html_attr') }}"/>
	<meta name="keywords" content="{{ 'meta_keywords'|trans({}, 'our_story')|e('html_attr') }}"/>
	<meta property="og:title" content="{{ 'og_title'|trans({}, 'our_story')|e('html_attr') }}"/>
	<meta property="og:description" content="{{ 'og_description'|trans({}, 'our_story')|e('html_attr') }}"/>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
{% endblock %}

{% set bodyClass = 'ourstorypage' %}

{% block body %}
	<main id="main-content" class="our-story-page">
		{% include 'components/our_story/_hero.html.twig' %}
		{% include 'components/our_story/_section-origin.html.twig' %}
		{% include 'components/our_story/_section-history.html.twig' %}
		{% include 'components/our_story/_section-spirit.html.twig' %}
		{% include 'components/our_story/_section-legacy.html.twig' %}
		{% include 'components/our_story/_section-team.html.twig' %}
		{% include 'components/our_story/_section-values.html.twig' %}
		{% include 'components/our_story/_section-cta.html.twig' %}
	</main>
{% endblock %}

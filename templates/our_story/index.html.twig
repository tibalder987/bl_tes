{% extends 'base.html.twig' %}

{% block title %}
	{{ 'page_title'|trans({}, 'our_story') }}
{% endblock %}

{% block meta %}
	<meta name="description" content="{{ 'meta_description'|trans({}, 'our_story')|e('html_attr') }}"/>
	<meta name="keywords" content="{{ 'meta_keywords'|trans({}, 'our_story')|e('html_attr') }}"/>
	<meta property="og:title" content="{{ 'og_title'|trans({}, 'our_story')|e('html_attr') }}"/>
	<meta property="og:description" content="{{ 'og_description'|trans({}, 'our_story')|e('html_attr') }}"/>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
{% endblock %}

{% set bodyClass = 'ourstorypage' %}

{% block body %}
	<main id="main-content" class="our-story-page">
		<section class="hero-section">
			<div class="hero-section__content">
				<div class="hero-section__title">{{ 'hero.title'|trans({}, 'our_story') }}</div>
				<div class="hero-section__subtitle">
					{{ 'hero.subtitle'|trans({}, 'our_story')|raw }}
				</div>
			</div>
		</section>

		<section class="section-1 have-animation">
			<div class="section-1__content">
				<div class="section-1__left">
					<div class="section-1__images">
						<img data-aos="fade-up" src="{{ asset('images/our-story/section-1/jimmy-buffet.jpg') }}" class="section-1__jimmy-buffet-toast" alt="{{ 'img.jimmy_buffet'|trans({}, 'our_story')|e('html_attr') }}">
					</div>
				</div>
				<div class="section-1__right">
					<h3 class="section-1__title">{{ 's1.title'|trans({}, 'our_story')|raw }}</h3>
					<div class="section-1__text">
						<p>{{ 's1.p1'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's1.p2'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's1.p3'|trans({}, 'our_story')|raw }}</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section-2">
			<div class="section-2__content">
				<div class="section-2__left">
					<h3 class="section-2__title icon-title-red">
						<div>{{ 's2.title'|trans({}, 'our_story')|raw }}</div>
					</h3>
					<div class="section-2__left-content">
						<div class="section-2__left-content-text">
							<p>{{ 's2.p1'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's2.p2'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's2.p3'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's2.p4'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's2.p5'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's2.p6'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's2.p7'|trans({}, 'our_story')|raw }}</p>
						</div>
						<div class="section-2__right">
							<img data-aos="fade-up" data-aos-delay="400" src="{{ asset('images/our-story/section-2/entrance.jpg') }}" class="section-2__entrance-signage" alt="{{ 'img.entrance_signage'|trans({}, 'our_story')|e('html_attr') }}">
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section-2-bis">
			<div class="section-2-bis__content">
				<div class="section-2-bis__left">
					<div class="section-2-bis__images">
						<img data-aos="fade-up" data-aos-delay="200" src="{{ asset('images/our-story/section-2/entrance_2.jpg') }}" class="section-2-bis__sunset" alt="{{ 'img.lagoon_sunset'|trans({}, 'our_story')|e('html_attr') }}">
					</div>
				</div>
				<div class="section-2-bis__right">
					<div class="section-2-bis__text">
						<p>{{ 's2bis.p1'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's2bis.p2'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's2bis.p3'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's2bis.p4'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's2bis.p5'|trans({}, 'our_story')|raw }}</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section-3">
			<div class="section-3__content">
				<div class="section-3__left">
					<h3 class="section-3__title icon-title-red">{{ 's3.title'|trans({}, 'our_story')|raw }}</h3>
					<div class="section-3__text">
						<p>{{ 's3.p1'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's3.p2'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's3.p3'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's3.p4'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's3.p5'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's3.p6'|trans({}, 'our_story')|raw }}</p>
					</div>
				</div>
				<div class="section-3__right">
					<img data-aos="fade-down" data-aos-delay="200" src="{{ asset('images/our-story/section-3/beach.jpg') }}" class="section-3__lagoon-beach" alt="{{ 'img.lagoon_beach'|trans({}, 'our_story')|e('html_attr') }}">
					<img data-aos="fade-up" data-aos-delay="400" src="{{ asset('images/our-story/section-3/welcome.jpg') }}" class="section-3__lagoon-boardwalk" alt="{{ 'img.lagoon_boardwalk'|trans({}, 'our_story')|e('html_attr') }}">
				</div>
			</div>
		</section>

		<section class="section-4 have-animation">
			<div class="section-4__content">
				<div class="section-4__left">
					<h3 class="section-4__title icon-title">
						<div>{{ 's4.title'|trans({}, 'our_story')|raw }}</div>
					</h3>
					<div class="section-4__left-content">
						<div class="section-4__left-content-text">
							<p>{{ 's4.p1'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's4.p2'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's4.p3'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's4.p4'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's4.p5'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's4.p6'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's4.p7'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's4.p8'|trans({}, 'our_story')|raw }}</p>
						</div>
						<div class="section-4__right">
							<img data-aos="fade-down" data-aos-delay="200" src="{{ asset('images/our-story/section-4/marilu-henner.jpg') }}" class="section-4__marilu-henner" alt="{{ 'img.marilu_henner'|trans({}, 'our_story')|e('html_attr') }}">
							<img data-aos="fade-up" data-aos-delay="400" src="{{ asset('images/our-story/section-4/dining.jpg') }}" class="section-4__sand-floor-dining" alt="{{ 'img.sand_floor_dining'|trans({}, 'our_story')|e('html_attr') }}">
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section-5">
			<div class="section-5__content">
				<div class="section-5__left">
					<div class="section-5__images">
						<img data-aos="fade-up" data-aos-delay="200" src="{{ asset('images/our-story/section-5/group_dexter.jpg') }}" class="section-5__dexter-team-portrait" alt="{{ 'img.dexter_team'|trans({}, 'our_story')|e('html_attr') }}">
					</div>
				</div>
				<div class="section-5__right">
					<h3 class="section-5__title icon-title-red">{{ 's5.title'|trans({}, 'our_story')|raw }}</h3>
					<div class="section-5__text">
						<p>{{ 's5.p1'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's5.p2'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's5.p3'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's5.p4'|trans({}, 'our_story')|raw }}</p>
					</div>
				</div>
			</div>
			<div class="section-5__content reverse">
				<div class="section-5__right">
					<div class="section-5__text">
						<p>{{ 's5.rev.p1'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's5.rev.p2'|trans({}, 'our_story')|raw }}</p>
						<p>{{ 's5.rev.p3'|trans({}, 'our_story')|raw }}</p>
					</div>
				</div>
				<div class="section-5__left">
					<div class="section-5__images">
						<img data-aos="fade-up" data-aos-delay="200" src="{{ asset('images/our-story/section-5/overview.jpg') }}" class="section-5__aerial-overview" alt="{{ 'img.aerial_overview'|trans({}, 'our_story')|e('html_attr') }}">
					</div>
				</div>
			</div>
		</section>

		<section class="section-6 have-animation">
			<div class="section-6__content">
				<div class="section-6__left">
					<h3 class="section-6__title icon-title">
						<div>{{ 's6.title'|trans({}, 'our_story')|raw }}</div>
					</h3>
					<div class="section-6__left-content">
						<div class="section-6__left-content-text">
							<p>{{ 's6.p1'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's6.p2'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's6.p3'|trans({}, 'our_story')|raw }}</p>
							<p>{{ 's6.p4'|trans({}, 'our_story')|raw }}</p>
						</div>
						<div class="section-6__right">
							<img data-aos="fade-up" data-aos-delay="400" src="{{ asset('images/our-story/section-6/name-board.png') }}" class="section-6__hotel-name-board" alt="{{ 'img.hotel_name_board'|trans({}, 'our_story')|e('html_attr') }}">
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section-7">
			<div class="section-7__content">
				<h3 class="section-7__title">{{ 's7.title'|trans({}, 'our_story')|raw }}</h3>
				<div class="section-7__buttons">
					<a href="https://agilysis.com" class="btn-primary">{{ 's7.btn_primary'|trans({}, 'our_story') }}
						<i class="fa-solid fa-arrow-right"></i>
					</a>
					<a href="{{ path('app_contact', { service: 'stay' }) }}" class="btn-secondary">{{ 's7.btn_secondary'|trans({}, 'our_story') }}
						<i class="fa-solid fa-arrow-right"></i>
					</a>
				</div>
			</div>
		</section>
	</main>
{% endblock %}

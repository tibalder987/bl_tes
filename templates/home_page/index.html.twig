{% extends 'base.html.twig' %}

{% block title %}{{ 'page_title'|trans({}, 'home') }}{% endblock %}

{% block meta %}
	<meta name="description" content="{{ 'meta_description'|trans({}, 'home')|e('html_attr') }}"/>
	<meta name="keywords" content="{{ 'meta_keywords'|trans({}, 'home')|e('html_attr') }}"/>
	<meta property="og:title" content="{{ 'og_title'|trans({}, 'home')|e('html_attr') }}"/>
	<meta property="og:description" content="{{ 'og_description'|trans({}, 'home')|e('html_attr') }}"/>
{% endblock %}

{% block stylesheets %}{{ parent() }}{% endblock %}

{% set bodyClass = 'homepage' %}

{% block body %}
<main>
	{% include 'components/home/_hero.html.twig' %}
	{% include 'components/home/_section-story.html.twig' %}
	{% include 'components/home/_section-atmosphere.html.twig' %}
	{% include 'components/home/_section-stay.html.twig' %}
	{% include 'components/home/_section-dine.html.twig' %}
	{% include 'components/home/_section-flow.html.twig' %}
	{% include 'components/home/_section-media.html.twig' %}
	{% include 'components/home/_section-closing.html.twig' %}
</main>
{% endblock %}

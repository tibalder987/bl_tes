<!DOCTYPE html>
<html style="height: 100%;" lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Sélectionner une image</title>
		{{ encore_entry_link_tags('file-selector') }}
		<style>
			.selector-info {
				background: #002043;
				color: white;
				padding: 0.75rem 1rem;
				text-align: center;
				font-size: 0.9rem;
				position: sticky;
				top: 0;
				z-index: 1000;
			}
			.selector-info i {
				margin-right: 0.5rem;
			}
			#file-selector-app {
				height: calc(100vh - 50px);
			}
		</style>
	</head>
	<body style="height: 100%;">
		<div id="file-selector-app" data-csrf-token="{{ csrf_token }}"></div>

		<script>
			// Inject CSRF token for Vue.js application
window.FILE_SELECTOR_CSRF_TOKEN = "{{ csrf_token }}";
		</script>
		{{ encore_entry_script_tags('file-selector') }}
	</body>
</html>

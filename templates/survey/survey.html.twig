<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>Enquête de satisfaction</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
        <link rel="stylesheet" href="{{ asset('survey/survey.css') }}">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;700&display=swap" rel="stylesheet">
    </head>
    <body class="bg-light">
        <div class="section w-100">
            <div class="container">
                <div class="row">
                    <div class="col-lg-8 offset-lg-2">
                        <div class="d-flex align-items-center justify-content-center">
                            <div class="text-center my-4">
                                <img class="m-2" src="{{ app.request.attributes.get('logo') }}" alt="{{ app.request.attributes.get('seo').metaTitle }}" style="max-height: 150px"/>
                            </div>
                        </div>

                        <div class="card border-0 shadow">
                            <div class="card-body py-4 px-5 w-100">

                                {% for label, messages in app.flashes %}
                                    {% for message in messages %}
                                        <div class="p-3 alert alert-{{ label }}">
                                            <div class="container text-center">
                                                {{ message }}
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% endfor %}


                                {% if surveyAccess %}
                                    {% if surveyAccess.survey.intro %}
                                        <p class="card-text text-center">{{ surveyAccess.survey.intro }}</p>
                                    {% endif %}

                                    {{ form_start(form) }}
                                        {{ form_errors(form) }}
                                        <h2 class="card-title mb-5 text-center">{{ surveyAccess.survey.title }}</h2>
                                    {{ form_end(form) }}

                                    <p class="card-text py-4 text-center"><br>Vos réponses seront traitées de manière confidentielle et utilisées uniquement dans le but d'améliorer notre qualité de service.</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script src="{{ asset('survey/survey.js') }}"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    </body>
</html>

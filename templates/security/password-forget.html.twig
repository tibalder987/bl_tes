{% extends 'base.html.twig' %}

{% block title %}Symfony - Réinitialisation de votre mot de passe{% endblock %}

{% block body %}
    <div class="container-fluid min-vh-100 d-flex align-items-center" style='background-image: url("{{ asset('images/bg_login.jpeg') }}"); background-size: cover'>
        <div class="container container-login mx-auto px-0">
            <div class="py-2 bg-black text-center">
                <img class="mw-100 my-2" src="{{ asset('images/logo.png') }}" alt="Administration">
            </div>
            <form class="bg-white p-5 fs-6" method="post">

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} fs-13 text-center">{{ message }}</div>
                    {% endfor %}
                {% endfor %}

                <label for="inputEmail">E-mail</label>
                <input type="text" value="" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>

                <button class="btn btn-lg w-100 btn-dark fs-6 text-center mt-4 text-white outline-0" type="submit">
                    Demander la réinitialisation de mon mot de passe
                </button>
            </form>
        </div>
    </div>
{% endblock %}

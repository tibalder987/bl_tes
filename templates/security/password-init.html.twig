{% extends 'base.html.twig' %}

{% block title %}Symfony - Modification du mot de passe{% endblock %}

{% block body %}
    <div class="container-fluid min-vh-100 d-flex align-items-center" style='background-image: url("{{ asset('images/bg_login.jpeg') }}"); background-size: cover'>
        <div class="container container-login mx-auto px-0">
            <div class="py-2 bg-black text-center">
                <img class="mw-100 my-2" src="{{ asset('images/logo.png') }}" alt="Administration">
            </div>
            <div class="bg-white py-5 px-4 fs-6">
                {{ form_start(form) }}

                    {% set formErrors = form.vars.errors.form.getErrors(true) %}
                    {% if formErrors|length %}
                        <div class="alert alert-danger">
                            {% for error in formErrors %}
                                <div>{{ error.message }}</div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }} fs-13 text-center">{{ message }}</div>
                        {% endfor %}
                    {% endfor %}

                    <div class="row error-hide mt-3">
                        {{ form_row(form.plainPassword) }}
                    </div>

                    <button class="btn btn-lg w-100 bg-black fs-6 text-center mt-4 text-white outline-0" type="submit">
                        Valider mon nouveau mot de passe
                    </button>
                {{ form_end(form) }}
            </div>
        </div>

    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}
	{{ 'page_title'|trans({}, 'stay') }}
{% endblock %}

{% block meta %}
	<meta name="description" content="{{ 'meta_description'|trans({}, 'stay')|e('html_attr') }}"/>
	<meta name="keywords" content="{{ 'meta_keywords'|trans({}, 'stay')|e('html_attr') }}"/>
	<meta property="og:title" content="{{ 'og_title'|trans({}, 'stay')|e('html_attr') }}"/>
	<meta property="og:description" content="{{ 'og_description'|trans({}, 'stay')|e('html_attr') }}"/>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
{% endblock %}

{% set bodyClass = 'staypage' %}

{% block body %}
	<main id="main-content" class="stay-page">
		{% include 'components/stay/_hero.html.twig' %}
		{% include 'components/stay/_section-intro.html.twig' %}
		{% include 'components/stay/_section-rooms.html.twig' %}
		{% include 'components/stay/_section-gallery.html.twig' %}
		{% include 'components/stay/_section-amenities.html.twig' %}
		<section class="section-5" aria-hidden="true"></section>
	</main>
{% endblock %}

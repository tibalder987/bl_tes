{% extends 'base.html.twig' %}

{% block title %}
	{{ 'page_title'|trans({}, 'flow') }}
{% endblock %}

{% block meta %}
	<meta name="description" content="{{ 'meta_description'|trans({}, 'flow')|e('html_attr') }}"/>
	<meta name="keywords" content="{{ 'meta_keywords'|trans({}, 'flow')|e('html_attr') }}"/>
	<meta property="og:title" content="{{ 'og_title'|trans({}, 'flow')|e('html_attr') }}"/>
	<meta property="og:description" content="{{ 'og_description'|trans({}, 'flow')|e('html_attr') }}"/>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
{% endblock %}

{% set bodyClass = 'flowpage' %}

{% block body %}
	<main id="main-content" class="flow-page">
		{% include 'components/flow/_hero.html.twig' %}
		{% include 'components/flow/_section-intro.html.twig' %}
		{% include 'components/flow/_section-explore.html.twig' %}
		{% include 'components/flow/_section-nature.html.twig' %}
		{% include 'components/flow/_section-dining.html.twig' %}
		{% include 'components/flow/_section-terrace.html.twig' %}
		{% include 'components/flow/_section-fitness.html.twig' %}
		{% include 'components/flow/_section-quote.html.twig' %}
		{% include 'components/flow/_section-experiences.html.twig' %}
	</main>
{% endblock %}
